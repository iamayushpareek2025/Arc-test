rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isRestaurantOwner(restaurantId) {
      return isAuthenticated() && request.auth.uid == restaurantId;
    }

    // Restaurants collection
    match /restaurants/{restaurantId} {
      allow read: if true; // Public directory for customers
      allow create, update: if isAuthenticated();
      allow delete: if false; // Soft-delete / status=INACTIVE only
    }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if true; // Public for viewing active rewards
      allow create, update: if isAuthenticated();
      allow delete: if false;
    }

    // Payment Requests collection
    match /paymentRequests/{requestId} {
      // Public read so customer can scan and view their invoice
      allow read: if true;

      // Creation allowed by merchant
      allow create: if request.resource.data.billAmount > 0
                    && request.resource.data.status == 'CREATED'
                    && request.resource.data.expiresAt > request.time.toMillis();

      // Updates strictly controlled:
      // - Cannot modify amount, restaurantWallet, cashbackBps
      // - Status transition to PAID/COMPLETED requires backend/verified transaction signature
      allow update: if (
        request.resource.data.billAmount == resource.data.billAmount &&
        request.resource.data.restaurantWallet == resource.data.restaurantWallet &&
        request.resource.data.cashbackBps == resource.data.cashbackBps &&
        (
          // Customer opening page transitions to PENDING
          (resource.data.status == 'CREATED' && request.resource.data.status == 'PENDING') ||
          // Merchant cancelling unpaid invoice
          ((resource.data.status == 'CREATED' || resource.data.status == 'PENDING') && request.resource.data.status == 'CANCELLED') ||
          // Expiration
          (request.resource.data.status == 'EXPIRED')
        )
      );

      allow delete: if false;
    }

    // Payments collection (Immutable audit trail)
    match /payments/{paymentId} {
      allow read: if true;
      allow create: if isAuthenticated() || request.resource.data.txHash != null;
      allow update, delete: if false; // Immutable ledger
    }
  }
}
